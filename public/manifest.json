{
  "manifest_version": 3,
  "name": "Chat Explorer for ChatGPT",
  "version": "0.1.0",
  "description": "Organize ChatGPT conversations in a local desktop-style explorer",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "system.display",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Chat Explorer for ChatGPT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-explorer": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open or focus Chat Explorer for ChatGPT"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
