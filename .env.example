# Default: scoped Full Dropbox app; public app key only, never app secret/tokens.
VITE_SYNC_PROVIDER=dropbox
VITE_DROPBOX_CLIENT_ID=
# Legacy provider configuration (optional).
VITE_SYNC_ORIGIN=
VITE_GOOGLE_CLIENT_ID_CHROMIUM=
VITE_GOOGLE_CLIENT_ID_FIREFOX=
# Optional public extension key, never a private signing key.
VITE_CHROMIUM_EXTENSION_KEY=
