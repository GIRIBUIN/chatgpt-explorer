{
	"name": "chat-explorer-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": false
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chat-explorer-sync",
			// Legacy example only. Replace with your own D1 ID before any deployment.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
