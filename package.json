{
  "name": "convoary",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "preview": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "build:chromium": "vite build --mode chromium",
    "build:firefox": "vite build --mode firefox",
    "test:browser:dropbox": "node scripts/verify-dropbox-browser.mjs",
    "test:browser:explorer": "node scripts/verify-explorer-browser.mjs",
    "test:browser:import": "node scripts/verify-import-browser.mjs",
    "test:browser:preferences": "node scripts/verify-ui-preferences-browser.mjs",
    "test:browser:drag": "node scripts/verify-drag-browser.mjs",
    "test:browser:marquee": "node scripts/verify-marquee-browser.mjs",
    "test:browser:sidebar-rename": "node scripts/verify-sidebar-rename-browser.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
